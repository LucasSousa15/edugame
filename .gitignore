# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files: keep secrets local, but version the example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local academic source material and generated deliverables
/AE_II_validação.pdf
/Manual_AEII_Projeto_Tecnologos_UNINTER.pdf
/Atividades Extensionistas - Modelo de Proposta de tema e Trabalho Final (1).docx
/docs/
/output/
/tmp/

# local source images and accidental binary artifacts
/*.png
*.winmd
