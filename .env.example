# Produção sem domínio próprio: remetente individual verificado na Brevo.
# Nunca exponha estas variáveis com o prefixo NEXT_PUBLIC_.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-xxxxxxxxx
BREVO_SENDER_EMAIL=seu-email@gmail.com
BREVO_SENDER_NAME=EduGame Carapicuíba
RESULT_RECIPIENT_EMAIL=professor@escola.com

# Alternativa compatível com a entrega acadêmica. Use EMAIL_PROVIDER=resend.
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=EduGame <resultados@seu-dominio-verificado.com>

# URL pública usada nos metadados. Substitua depois do primeiro deploy.
NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app
